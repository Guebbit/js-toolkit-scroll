{
  "name": "@guebbit/js-toolkit-scroll",
  "version": "1.1.0",
  "license": "AGPL-3.0-only",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "vitest run --typecheck.enabled --typecheck.only",
    "test:pack": "node scripts/packSmokeTest.mjs",
    "test:mutation": "stryker run",
    "test:mutation:check": "node scripts/mutationBaseline.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cy:serve": "http-server ./cypress/public/ -i -c-1 -d --cors -a localhost -p 8080",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "docs:dev": "vitepress dev docs --port 8080",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "verify": "npm run build && npm run test && npm run test:types && npm run cy:test && npm run test:pack && npm run lint",
    "prepublishOnly": "npm run verify && npm run docs:build",
    "publish:public": "npm publish --access public",
    "cy:test": "start-server-and-test cy:serve http://localhost:8080 cy:run"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/eslint": "^9.6.1",
    "@types/lodash": "^4.17.21",
    "@types/node": "^25.0.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cypress": "^15.7.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^5.2.0",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-unicorn": "^62.0.0",
    "fast-check": "^4.9.0",
    "globals": "^17.9.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.7.4",
    "start-server-and-test": "^3.0.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@guebbit/js-toolkit": "^1.0.8",
    "lodash": "^4.17.21"
  }
}
